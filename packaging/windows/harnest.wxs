<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Harnest" Manufacturer="Fused" Version="$(var.Version)"
           UpgradeCode="86085EE6-F11F-4AE7-9316-322D92699EB0" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Harnest is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="ARPURLINFOABOUT" Value="https://usefused.com/docs/harnest" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Harnest">
          <Component Id="Cli" Guid="$(var.ComponentGuid)">
            <File Id="HarnestExe" Source="$(var.Cli)" Name="harnest.exe" />
            <!-- HKCU is the key path for a per-user component. MSI owns only its PATH entry. -->
            <RegistryValue Root="HKCU" Key="Software\Fused\Harnest" Name="InstallDir"
                           Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
            <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]"
                         Action="set" Part="first" System="no" />
            <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <Feature Id="Harnest" Title="Harnest" Level="1">
      <ComponentRef Id="Cli" />
    </Feature>
    <!-- Run the native CLI as the installing user. Script policy is never involved.
         Return=check prevents a failed bootstrap from reporting installation success.
         The shared runtime contains user-managed state and is retained on uninstall. -->
    <CustomAction Id="InstallRuntime" FileRef="HarnestExe" ExeCommand="runtime install"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="InstallRuntime" After="InstallFiles" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
    </InstallExecuteSequence>
    <UI>
      <ProgressText Action="InstallRuntime" Message="Installing the Harnest runtime. Internet access may be required." />
    </UI>
  </Package>
</Wix>
