{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnest.dev/schemas/config.schema.json",
  "title": "Harnest agent configuration",
  "description": "Agent framework, runtime environment, and server configuration. Workload resource limits and replicas belong in harnest-deployment.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "server": {
      "description": "Optional standalone server overrides; omitted settings use safe defaults.",
      "$ref": "server.schema.json#/$defs/settings"
    },
    "apiVersion": { "const": "harnest.dev/v1alpha1" },
    "kind": { "const": "Agent" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "displayName": { "type": "string", "minLength": 1 },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(resources|scaling)$": { "description": "Ignored legacy settings; omitted from new projects." }
      },
      "required": ["entrypoint", "framework", "runtime"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "entrypoint": {
          "type": "string",
          "description": "Importable Python module and exported managed Agent/Graph or Agent.advanced definition, in module:symbol form.",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
        },
        "framework": {
          "type": "object",
          "description": "Compiler backend and managed or advanced authoring mode.",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "enum": ["adk", "langgraph"] },
            "mode": { "enum": ["managed", "advanced"], "default": "managed" }
          }
        },
        "interfaces": {
          "type": "object",
          "description": "Explicit opt-ins for non-server invocation surfaces.",
          "additionalProperties": false,
          "properties": {
            "cli": { "type": "boolean", "default": false }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "dependencyFile"],
          "properties": {
            "version": { "enum": ["3.10", "3.11", "3.12", "3.13", "3.14"] },
            "dependencyFile": {
              "const": "pyproject.toml",
              "description": "Agent dependency project synchronized into its isolated environment."
            }
          }
        },
        "environment": {
          "type": "object",
          "description": "Non-secret environment values. Credentials belong in spec.secrets.",
          "additionalProperties": { "type": "string" }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["environmentVariable", "secretRef"],
            "properties": {
              "environmentVariable": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
              "secretRef": {
                "type": "string",
                "minLength": 1,
                "description": "Opaque identifier resolved by the deployment engine, never a secret value."
              }
            }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "network": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "outbound": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            },
            "filesystem": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "readOnly": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "readWrite": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
