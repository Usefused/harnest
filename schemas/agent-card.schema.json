{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnest.dev/schemas/agent-card.schema.json",
  "title": "A2A-compatible Harnest agent card",
  "description": "Strict authoring schema for an A2A 1.0 Agent Card understood by Harnest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "version", "supportedInterfaces", "capabilities", "defaultInputModes", "defaultOutputModes", "skills"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "iconUrl": { "type": "string", "format": "uri" },
    "documentationUrl": { "type": "string", "format": "uri" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "url"],
      "properties": {
        "organization": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "supportedInterfaces": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered by preference; the first interface is preferred.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "protocolBinding", "protocolVersion"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "protocolBinding": {
            "type": "string",
            "minLength": 1,
            "description": "A core binding such as JSONRPC, GRPC, or HTTP+JSON, or a URI identifying a custom binding."
          },
          "protocolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "streaming": { "type": "boolean" },
        "pushNotifications": { "type": "boolean" },
        "extendedAgentCard": { "type": "boolean" },
        "extensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/agentExtension" }
        }
      }
    },
    "securitySchemes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/securityScheme" }
    },
    "securityRequirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/securityRequirement" }
    },
    "defaultInputModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "defaultOutputModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "tags"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "examples": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "inputModes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "outputModes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "signatures": {
      "type": "array",
      "items": { "$ref": "#/$defs/agentCardSignature" }
    }
  },
  "$defs": {
    "agentExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "params": { "type": "object" }
      }
    },
    "securityScheme": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "apiKeySecurityScheme": { "$ref": "#/$defs/apiKeySecurityScheme" },
        "httpAuthSecurityScheme": { "$ref": "#/$defs/httpAuthSecurityScheme" },
        "oauth2SecurityScheme": { "$ref": "#/$defs/oauth2SecurityScheme" },
        "openIdConnectSecurityScheme": { "$ref": "#/$defs/openIdConnectSecurityScheme" },
        "mtlsSecurityScheme": { "$ref": "#/$defs/mtlsSecurityScheme" }
      }
    },
    "apiKeySecurityScheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "name"],
      "properties": {
        "description": { "type": "string" },
        "location": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "httpAuthSecurityScheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme"],
      "properties": {
        "description": { "type": "string" },
        "scheme": { "type": "string", "minLength": 1 },
        "bearerFormat": { "type": "string" }
      }
    },
    "oauth2SecurityScheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flows"],
      "properties": {
        "description": { "type": "string" },
        "flows": { "$ref": "#/$defs/oauthFlows" },
        "oauth2MetadataUrl": { "type": "string", "format": "uri" }
      }
    },
    "oauthFlows": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "authorizationCode": { "$ref": "#/$defs/authorizationCodeFlow" },
        "clientCredentials": { "$ref": "#/$defs/tokenFlow" },
        "implicit": { "$ref": "#/$defs/implicitFlow" },
        "password": { "$ref": "#/$defs/tokenFlow" },
        "deviceCode": { "$ref": "#/$defs/deviceCodeFlow" }
      }
    },
    "authorizationCodeFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizationUrl", "tokenUrl", "scopes"],
      "properties": {
        "authorizationUrl": { "type": "string", "format": "uri" },
        "tokenUrl": { "type": "string", "format": "uri" },
        "refreshUrl": { "type": "string", "format": "uri" },
        "scopes": { "$ref": "#/$defs/scopes" },
        "pkceRequired": { "type": "boolean" }
      }
    },
    "tokenFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenUrl", "scopes"],
      "properties": {
        "tokenUrl": { "type": "string", "format": "uri" },
        "refreshUrl": { "type": "string", "format": "uri" },
        "scopes": { "$ref": "#/$defs/scopes" }
      }
    },
    "implicitFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizationUrl", "scopes"],
      "properties": {
        "authorizationUrl": { "type": "string", "format": "uri" },
        "refreshUrl": { "type": "string", "format": "uri" },
        "scopes": { "$ref": "#/$defs/scopes" }
      }
    },
    "deviceCodeFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceAuthorizationUrl", "tokenUrl", "scopes"],
      "properties": {
        "deviceAuthorizationUrl": { "type": "string", "format": "uri" },
        "tokenUrl": { "type": "string", "format": "uri" },
        "refreshUrl": { "type": "string", "format": "uri" },
        "scopes": { "$ref": "#/$defs/scopes" }
      }
    },
    "scopes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "openIdConnectSecurityScheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openIdConnectUrl"],
      "properties": {
        "description": { "type": "string" },
        "openIdConnectUrl": { "type": "string", "format": "uri" }
      }
    },
    "mtlsSecurityScheme": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "description": { "type": "string" } }
    },
    "securityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemes"],
      "properties": {
        "schemes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["list"],
            "properties": {
              "list": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "agentCardSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected", "signature"],
      "properties": {
        "protected": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "header": { "type": "object" }
      }
    }
  }
}
