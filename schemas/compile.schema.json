{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harnest compile selections",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "extras": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$"
      }
    }
  }
}
