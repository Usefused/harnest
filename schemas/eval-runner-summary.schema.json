{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnest.dev/schemas/eval-runner-summary.schema.json",
  "title": "Configured evaluation runner summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "status", "runners"],
  "properties": {
    "apiVersion": { "const": "harnest.dev/v1alpha1" },
    "kind": { "const": "EvalRunnerSummary" },
    "status": { "$ref": "#/$defs/status" },
    "runners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "artifacts"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "status": { "$ref": "#/$defs/status" },
          "artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "status": { "enum": ["passed", "failed", "not_evaluated", "error"] }
  }
}
